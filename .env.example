# Provider API keys. The server reads these via python-dotenv at startup.
# LiteLLM picks the right one per model based on the provider prefix.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides
# CONSULT_RUNS_DIR=~/.consult/runs
# CONSULT_MAX_RUN_USD=5.0
# CONSULT_CAPSULE_MODEL=anthropic/claude-haiku-4-5-20251001
# CONSULT_DEFAULT_SYNTHESISER=gemini/gemini-3.1-pro-preview
